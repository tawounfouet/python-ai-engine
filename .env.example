# ─────────────────────────────────────────────────────────────────────────────
# ai-engine — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS — Clés API
# ══════════════════════════════════════════════════════════════════════════════

# OpenAI (GPT-4o, GPT-4, GPT-3.5-turbo…)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenAI — Organisation (optionnel, pour les comptes multi-org)
# OPENAI_ORG_ID=org-...

# Anthropic (Claude 3 Opus, Sonnet, Haiku…)
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# Groq (Llama 3, Mixtral, Gemma via Groq Cloud)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google Gemini (Gemini 1.5 Pro, Flash…)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Mistral AI
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=...

# Cohere
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...


# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS — URLs de base (pour endpoints custom / proxies / Azure OpenAI)
# ══════════════════════════════════════════════════════════════════════════════

# OpenAI — base URL custom (Azure OpenAI, LiteLLM proxy, etc.)
# OPENAI_API_BASE=https://<resource>.openai.azure.com/

# Ollama — serveur local (défaut : http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Modèle Ollama par défaut
# OLLAMA_DEFAULT_MODEL=llama3.2


# ══════════════════════════════════════════════════════════════════════════════
# STORAGE — Backends de persistance
# ══════════════════════════════════════════════════════════════════════════════

# SQLite — chemin du fichier de base de données (relatif au répertoire courant)
# AIENGINE_SQLITE_PATH=agents.db

# PostgreSQL (backend SQLAlchemy asyncio)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_engine

# Redis (cache / sessions futures)
# REDIS_URL=redis://localhost:6379/0


# ══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ══════════════════════════════════════════════════════════════════════════════

# Niveau de log : DEBUG | INFO | WARNING | ERROR | CRITICAL (défaut : INFO)
# AIENGINE_LOG_LEVEL=INFO

# Activer le format JSON (machine-parseable) : true | false (défaut : false)
# AIENGINE_LOG_JSON=false

# Chemin du fichier de log rotatif (désactivé si vide)
# AIENGINE_LOG_FILE=logs/ai_engine.log

# Activer le logging asynchrone via QueueHandler : true | false (défaut : false)
# AIENGINE_LOG_ASYNC=false


# ══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ══════════════════════════════════════════════════════════════════════════════

# Environnement : development | staging | production (défaut : development)
# AIENGINE_ENV=development

# Nom de l'application (affiché dans les logs)
# AIENGINE_APP_NAME=ai-engine

# Version (injectée dans les logs comme extra_field)
# AIENGINE_VERSION=0.1.0


# ══════════════════════════════════════════════════════════════════════════════
# INTÉGRATIONS FRAMEWORK (optionnel)
# ══════════════════════════════════════════════════════════════════════════════

# Django — SECRET_KEY (si intégration django activée)
# DJANGO_SECRET_KEY=django-insecure-...

# FastAPI — hôte et port du serveur de dev
# FASTAPI_HOST=0.0.0.0
# FASTAPI_PORT=8000
